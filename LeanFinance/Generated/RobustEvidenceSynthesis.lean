import LeanFinance.Epistemic.FiniteRobustSynthesis

namespace LeanFinance.Generated.RobustEvidenceSynthesis

open LeanFinance.Epistemic

/-- Generated by `python -m tools.robust_evidence_synth synth`. -/

inductive History where
  | honest
  | hiddenSweep
  | undeclaredBaseline
  deriving Repr, DecidableEq

inductive Channel where
  | selfReport
  | declarationRegistry
  | executorA
  | executorMirror
  | executorB
  | resultBundle
  | rfc3161Anchor
  deriving Repr, DecidableEq

inductive Domain where
  | researcher
  | registry
  | executorA
  | executorB
  | tsa
  deriving Repr, DecidableEq

inductive Observation where
  | obs0
  | obs1
  | obs2
  | obs3
  | obs4
  deriving Repr, DecidableEq

def histories : List History :=
  [.honest, .hiddenSweep, .undeclaredBaseline]

def channels : List Channel :=
  [.selfReport, .declarationRegistry, .executorA, .executorMirror, .executorB, .resultBundle, .rfc3161Anchor]

def observe : Channel → History → Observation
  | .selfReport, .honest => .obs0
  | .selfReport, .hiddenSweep => .obs0
  | .selfReport, .undeclaredBaseline => .obs1
  | .declarationRegistry, .honest => .obs0
  | .declarationRegistry, .hiddenSweep => .obs0
  | .declarationRegistry, .undeclaredBaseline => .obs1
  | .executorA, .honest => .obs0
  | .executorA, .hiddenSweep => .obs2
  | .executorA, .undeclaredBaseline => .obs0
  | .executorMirror, .honest => .obs0
  | .executorMirror, .hiddenSweep => .obs2
  | .executorMirror, .undeclaredBaseline => .obs0
  | .executorB, .honest => .obs0
  | .executorB, .hiddenSweep => .obs2
  | .executorB, .undeclaredBaseline => .obs0
  | .resultBundle, .honest => .obs3
  | .resultBundle, .hiddenSweep => .obs3
  | .resultBundle, .undeclaredBaseline => .obs3
  | .rfc3161Anchor, .honest => .obs4
  | .rfc3161Anchor, .hiddenSweep => .obs4
  | .rfc3161Anchor, .undeclaredBaseline => .obs4

def claim : History → Bool
  | .honest => true
  | .hiddenSweep => false
  | .undeclaredBaseline => false

def cost : Channel → Nat
  | .selfReport => 2
  | .declarationRegistry => 3
  | .executorA => 4
  | .executorMirror => 1
  | .executorB => 4
  | .resultBundle => 1
  | .rfc3161Anchor => 3

def trustDomain : Channel → Domain
  | .selfReport => .researcher
  | .declarationRegistry => .registry
  | .executorA => .executorA
  | .executorMirror => .executorA
  | .executorB => .executorB
  | .resultBundle => .researcher
  | .rfc3161Anchor => .tsa

def model : BoundedEvidenceModel History Channel Observation :=
  {
    histories := histories
    channels := channels
    observe := observe
    claim := claim
    cost := cost
  }

def faults : List (List Domain) :=
  [[], [.researcher], [.registry], [.executorA], [.executorB], [.tsa]]

abbrev Candidate := Fin 128

def bitSelected (mask index : Nat) : Bool :=
  ((mask / (2 ^ index)) % 2) == 1

def decodeMask (mask : Nat) : List Channel :=
  (if bitSelected mask 0 then [.selfReport] else [])
    ++ (if bitSelected mask 1 then [.declarationRegistry] else [])
    ++ (if bitSelected mask 2 then [.executorA] else [])
    ++ (if bitSelected mask 3 then [.executorMirror] else [])
    ++ (if bitSelected mask 4 then [.executorB] else [])
    ++ (if bitSelected mask 5 then [.resultBundle] else [])
    ++ (if bitSelected mask 6 then [.rfc3161Anchor] else [])

def decode (candidate : Candidate) : List Channel :=
  decodeMask candidate.val

def selected : Candidate :=
  ⟨27, by decide⟩

theorem selectedBoundedlyRobust :
    BoundedRobustSelectionVerifies
      model trustDomain faults (decode selected) := by
  apply boundedRobustVerifiesBool_sound
  decide

theorem checkerAcceptedCostMinimal :
    ∀ candidate : Candidate,
      boundedRobustVerifiesBool
          model trustDomain (decode candidate) faults = true →
        selectionCost model (decode selected) ≤
          selectionCost model (decode candidate) := by
  decide

def synthesisCertificate :
    BoundedRobustSynthesisCertificate
      model trustDomain faults Candidate decode selected :=
  {
    selectedVerifies := selectedBoundedlyRobust
    minimum := by
      intro candidate candidateVerifies
      exact checkerAcceptedCostMinimal candidate
        (boundedRobustVerifiesBool_complete
          model trustDomain faults (decode candidate)
          candidateVerifies)
  }

theorem selectedCostMinimal
    (candidate : Candidate)
    (candidateVerifies :
      BoundedRobustSelectionVerifies
        model trustDomain faults (decode candidate)) :
    selectionCost model (decode selected) ≤
      selectionCost model (decode candidate) :=
  synthesisCertificate.selectedCostMinimal
    candidate candidateVerifies

theorem faultsComplete :
    FaultListComplete
      (fun failedDomains : List Domain =>
        failedDomains.Nodup ∧ failedDomains.length < 2)
      faults := by
  intro failedDomains allowed
  cases failedDomains with
  | nil =>
      simp [faults]
  | cons head tail =>
      cases tail with
      | nil =>
          cases head <;> simp [faults]
      | cons second rest =>
          exfalso
          exact (Nat.not_lt_of_ge (by simp)) allowed.2

theorem selectedTrustDomainConnectivity :
    TrustDomainConnectivityAtLeast
      model.observe
      (fun channel => channel ∈ decode selected)
      model.ClaimHolds trustDomain 2 :=
  boundedRobust_semantically_sound
    model trustDomain faults (decode selected)
    (fun failedDomains : List Domain =>
      failedDomains.Nodup ∧ failedDomains.length < 2)
    (by intro history; cases history <;> simp [model, histories])
    faultsComplete selectedBoundedlyRobust

end LeanFinance.Generated.RobustEvidenceSynthesis
