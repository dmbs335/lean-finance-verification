{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrite-lab.example/schemas/lfv-robust-evidence-policy-v1.schema.json",
  "title": "Lean Finance Verification robust evidence policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "required_connectivity",
    "channel_domains",
    "faults"
  ],
  "properties": {
    "schema_version": {"const": "lfv-robust-evidence-policy-v1"},
    "name": {"type": "string", "minLength": 1},
    "required_connectivity": {"type": "integer", "minimum": 1},
    "channel_domains": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "faults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rank", "compromised_domains", "description"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "rank": {"type": "integer", "minimum": 0},
          "compromised_domains": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "description": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
