{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrite-lab.example/schemas/lfv-evidence-synthesis-certificate-v1.schema.json",
  "title": "Lean Finance Verification evidence synthesis certificate v1",
  "type": "object",
  "required": ["schema_version", "canonical_format", "name", "namespace", "claim_name", "model_digest", "cost_weights", "histories", "channels", "disagreement_edges", "candidate_count", "verifying_candidate_count", "status", "certificate_digest"],
  "properties": {
    "schema_version": {"const": "lfv-evidence-synthesis-certificate-v1"},
    "canonical_format": {"const": "lfv-canonical-json-v1"},
    "status": {"enum": ["synthesized", "impossible"]},
    "candidate_count": {"type": "integer", "minimum": 1},
    "verifying_candidate_count": {"type": "integer", "minimum": 0},
    "disagreement_edges": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "left", "right", "separators"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "left": {"type": "string", "minLength": 1},
          "right": {"type": "string", "minLength": 1},
          "separators": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "model_digest": {"$ref": "#/$defs/digest"},
    "certificate_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "schema_id", "digest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "schema_id": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
