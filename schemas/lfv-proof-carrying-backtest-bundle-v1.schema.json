{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrite-lab.example/schemas/lfv-proof-carrying-backtest-bundle-v1.schema.json",
  "title": "Lean Finance Verification proof-carrying backtest bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_format",
    "experiment",
    "artifacts",
    "decision",
    "ledger",
    "anchor",
    "selected_trial_index",
    "claim",
    "execution",
    "bundle_digest"
  ],
  "properties": {
    "schema_version": {"const": "lfv-proof-carrying-backtest-bundle-v1"},
    "canonical_format": {"const": "lfv-canonical-json-v1"},
    "experiment": {
      "type": "object",
      "required": ["name", "lean_namespace", "hash_algorithm"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "lean_namespace": {"type": "string", "minLength": 1},
        "hash_algorithm": {"enum": ["sha256", "sha512", "blake3"]}
      }
    },
    "artifacts": {
      "type": "object",
      "required": ["code", "datasets", "parameters", "environment", "result", "features"],
      "properties": {
        "code": {"$ref": "#/$defs/artifactEnvelope"},
        "datasets": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "parameters": {"$ref": "#/$defs/artifactEnvelope"},
        "environment": {"$ref": "#/$defs/artifactEnvelope"},
        "result": {"$ref": "#/$defs/artifactEnvelope"},
        "features": {"type": "array", "items": {"type": "object"}}
      }
    },
    "decision": {"type": "object"},
    "ledger": {"type": "object"},
    "anchor": {"type": "object"},
    "selected_trial_index": {"type": "integer", "minimum": 0},
    "claim": {
      "type": "object",
      "required": ["result_hash", "metric_name", "metric_value"],
      "properties": {
        "result_hash": {"type": "string", "minLength": 1},
        "metric_name": {"type": "string", "minLength": 1},
        "metric_value": {"type": "integer"}
      }
    },
    "execution": {"type": "object"},
    "bundle_digest": {"$ref": "#/$defs/artifactRef"}
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "schema_id", "digest"],
      "properties": {
        "algorithm": {"enum": ["sha256", "sha512", "blake3"]},
        "schema_id": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]+$"}
      }
    },
    "artifactEnvelope": {
      "type": "object",
      "required": ["ref", "canonical_format", "serialized_size"],
      "properties": {
        "ref": {"$ref": "#/$defs/artifactRef"},
        "canonical_format": {"const": "lfv-canonical-json-v1"},
        "serialized_size": {"type": "integer", "minimum": 0}
      }
    }
  }
}
