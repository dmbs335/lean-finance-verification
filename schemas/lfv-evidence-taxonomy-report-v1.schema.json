{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrite-lab.example/schemas/lfv-evidence-taxonomy-report-v1.schema.json",
  "title": "Lean Finance Verification evidence taxonomy report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_format",
    "name",
    "reference_history",
    "known_attacks",
    "candidate_attacks",
    "basis_channels",
    "spec_digest",
    "model_digest",
    "attack_count",
    "class_count",
    "attacks",
    "equivalence_classes",
    "strict_signature_subsumption",
    "candidate_novelty",
    "report_digest"
  ],
  "properties": {
    "schema_version": {"const": "lfv-evidence-taxonomy-report-v1"},
    "canonical_format": {"const": "lfv-canonical-json-v1"},
    "name": {"type": "string", "minLength": 1},
    "reference_history": {"type": "string", "minLength": 1},
    "known_attacks": {"type": "array", "items": {"type": "string"}},
    "candidate_attacks": {"type": "array", "items": {"type": "string"}},
    "basis_channels": {"type": "array", "items": {"type": "string"}},
    "spec_digest": {"$ref": "#/$defs/digest"},
    "model_digest": {"$ref": "#/$defs/digest"},
    "attack_count": {"type": "integer", "minimum": 1},
    "class_count": {"type": "integer", "minimum": 1},
    "attacks": {"type": "array", "minItems": 1},
    "equivalence_classes": {"type": "array", "minItems": 1},
    "strict_signature_subsumption": {"type": "array"},
    "candidate_novelty": {"type": "array", "minItems": 1},
    "report_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "schema_id", "digest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "schema_id": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
