{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrite-lab.example/schemas/lfv-evidence-taxonomy-spec-v1.schema.json",
  "title": "Lean Finance Verification evidence taxonomy specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "evidence_model",
    "reference_history",
    "known_attacks",
    "candidate_attacks",
    "basis_channels"
  ],
  "properties": {
    "schema_version": {"const": "lfv-evidence-taxonomy-spec-v1"},
    "name": {"type": "string", "minLength": 1},
    "evidence_model": {"type": "string", "minLength": 1},
    "reference_history": {"type": "string", "minLength": 1},
    "known_attacks": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "candidate_attacks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "basis_channels": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
