{
  "schema_version": "lfv-temporal-noninterference-v1",
  "name": "gs-quant-style-data-source-semantic-regression",
  "cutoff_time": 35,
  "decision_times": [25, 35],
  "points": [
    {"id": "p0", "observation_time": 10, "available_time": 10, "value": 100, "representation": "date"},
    {"id": "p4", "observation_time": 40, "available_time": 40, "value": 101, "representation": "date"},
    {"id": "p1", "observation_time": 20, "available_time": 20, "value": 99, "representation": "date"},
    {"id": "p2", "observation_time": 25, "available_time": 26, "value": 150, "representation": "date"},
    {"id": "p3", "observation_time": 30, "available_time": 30, "value": 98, "representation": "date"}
  ],
  "engines": [
    {"id": "causalForwardFill", "semantics": "causal_forward_fill", "threshold": 100},
    {"id": "globalLastFill", "semantics": "global_last_fill", "threshold": 100},
    {"id": "observationOnlyForwardFill", "semantics": "observation_only_forward_fill", "threshold": 100},
    {"id": "bidirectionalInterpolation", "semantics": "bidirectional_interpolation", "threshold": 100},
    {"id": "mutatingGlobalLastFill", "semantics": "mutating_global_last_fill", "threshold": 100}
  ],
  "mutations": [
    {
      "id": "appendTwoFutureExtremes",
      "description": "Append two causally unavailable extreme future rows.",
      "operations": [
        {"kind": "append_point", "point": {"id": "p5", "observation_time": 100, "available_time": 100, "value": 500, "representation": "timestamp"}},
        {"kind": "append_point", "point": {"id": "p6", "observation_time": 110, "available_time": 110, "value": 999, "representation": "timestamp"}}
      ]
    },
    {
      "id": "reviseFutureValue",
      "description": "Rewrite a row whose observation and availability are after every audited decision.",
      "operations": [
        {"kind": "revise_value", "point_id": "p4", "value": 777}
      ]
    },
    {
      "id": "reorderEquivalent",
      "description": "Reorder the same logical point set without changing causal content.",
      "operations": [
        {"kind": "reorder", "order": ["p0", "p1", "p2", "p3", "p4"]}
      ]
    },
    {
      "id": "representationEquivalent",
      "description": "Change only timestamp representations while preserving logical times and values.",
      "operations": [
        {"kind": "change_representation", "point_id": "p0", "representation": "timestamp"},
        {"kind": "change_representation", "point_id": "p1", "representation": "epoch"}
      ]
    },
    {
      "id": "reviseKnownPast",
      "description": "Change a point already available by a decision; the noninterference premise must not be claimed.",
      "operations": [
        {"kind": "revise_value", "point_id": "p1", "value": 500}
      ]
    },
    {
      "id": "releaseLatePointAtDecision",
      "description": "Move a late same-bar release into the decision-time information set.",
      "operations": [
        {"kind": "change_availability", "point_id": "p2", "available_time": 25}
      ]
    }
  ]
}
